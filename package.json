{
  "name": "nova",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1 --port 3100",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1 --port 3100",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:seed": "tsx prisma/seed.ts",
    "db:reset": "prisma migrate reset --force",
    "worker": "tsx services/worker/index.ts",
    "macos:build": "bash macos/launcher/scripts/build.sh",
    "verify:launcher": "bash scripts/verify-launcher-startup.sh",
    "nachweis:phase1": "tsx scripts/nachweis-phase1-kopf.ts",
    "test:kopf": "tsx scripts/test-kopf.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.16.3",
    "imapflow": "^2.0.7",
    "mailparser": "^3.9.28",
    "next": "16.3.5",
    "nodemailer": "^10.0.10",
    "openai": "^7.20.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/mailparser": "^3.4.6",
    "@types/node": "^20",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.5",
    "prisma": "^6.16.3",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5"
  },
  "description": "NOVA – persönlicher KI-Business-Assistent",
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}
