DATABASE_URL="file:./dev.db"
NOVA_ORG_SLUG="joachim"
NOVA_USER_EMAIL="joachim@local"

OPENAI_API_KEY=

# Websuche nutzt OpenAI Web Search über OPENAI_API_KEY (SearchProvider, austauschbar).

# Voice (OpenAI TTS). Keine endgültige Stimme – zum Testen wechseln.
NOVA_VOICE=marin
NOVA_VOICE_SPEED=1.1

# Avatar Animation / NVIDIA Audio2Face-3D NIM (gRPC, nicht Browser)
# NOVA_A2F_GRPC_URL=127.0.0.1:52000
# NOVA_A2F_SERVICE_URL=http://127.0.0.1:8787
# ANTHROPIC_API_KEY=
# LOCAL_AI_BASE_URL=http://127.0.0.1:11434
# LOCAL_AI_MODEL=llama3.1

# NOVA Desktop Service (nur localhost)
# NOVA_WEB_HOST=127.0.0.1
# NOVA_WEB_PORT=3100
# NOVA_DESKTOP_HOST=127.0.0.1
# NOVA_DESKTOP_PORT=47821
# NOVA_DESKTOP_TOKEN=
# NOVA_WORKSPACE_ROOTS=
# Physische Arbeitsablage. Leer = erstes gemountetes Volume aus NOVA_EXTERNAL_VOLUMES.
# NOVA_WORKSPACE_ROOT=
# Externe Platten unter /Volumes, kommagetrennt. Google Drive wird nicht genutzt.
# NOVA_EXTERNAL_VOLUMES=ELEVUM
# NOVA_CURSOR_AGENT_BIN=
# Cursor Agent CLI: ~/.local/bin/agent
# Einmalige Anmeldung: agent login

# Mail-OAuth. Keine Benutzerpasswörter. Client-IDs kommen aus der Anbieter-App, nicht aus dem Code.
# NOVA_GOOGLE_OAUTH_CLIENT_ID=
# NOVA_MICROSOFT_OAUTH_CLIENT_ID=
# Optional, nur wenn die OAuth-App vertraulich ist. Kein Benutzerpasswort.
# NOVA_GOOGLE_OAUTH_CLIENT_SECRET=
# NOVA_MICROSOFT_OAUTH_CLIENT_SECRET=
# NOVA_MAIL_OAUTH_REDIRECT_URI=http://127.0.0.1:3100/api/mail/oauth/callback
# Schlüssel für die lokale Token-Datei, sonst .nova/mail.key
# NOVA_MAIL_STEERABLE=info@elevum.io,joachim@rankpilot.de
# Default ohne Env: info@elevum.io + joachim@rankpilot.de (nur diese darf NOVA steuern)
