generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Organization {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  members           OrganizationMember[]
  projects          Project[]
  companies         Company[]
  contacts          Contact[]
  tasks             Task[]
  jobs              Job[]
  jobSteps          JobStep[]
  activities        Activity[]
  memoryEntries     MemoryEntry[]
  memoryRelations   MemoryRelation[]
  meetings          Meeting[]
  memos             Memo[]
  documents         Document[]
  communications    Communication[]
  approvalRequests  ApprovalRequest[]
  approvalPolicies  ApprovalPolicy[]
  conversations     Conversation[]
  conversationMsgs  ConversationMessage[]
  sources           Source[]
  connectorConfigs  ConnectorConfig[]
  aiProviderConfigs AiProviderConfig[]
  computerJobs      ComputerJob[]
  computerActions   ComputerAction[]
  projectContexts   ProjectContext[]
  cursorSessions    CursorSession[]
  knowledgeSources  KnowledgeSource[]
  knowledgeDocuments KnowledgeParsedDocument[]
  knowledgeItems    KnowledgeItem[]
  knowledgeEmbeddings KnowledgeEmbedding[]
  knowledgeImports  KnowledgeImport[]
  knowledgeContradictions KnowledgeContradiction[]
  retrievalChunks   RetrievalChunk[]
  retrievalEmbeddings RetrievalEmbedding[]
  embeddingUsages   EmbeddingUsage[]
  mailAccounts      MailAccount[]
  mailThreads       MailThread[]
  mailMessages      MailMessage[]
  mailAttachments   MailAttachment[]
  mailFollowUps     MailFollowUp[]
  mailAuditEvents   MailAuditEvent[]
  workspaceEntries  WorkspaceEntry[]
  artifacts         Artifact[]
  reviewSessions    ReviewSession[]
  workItems         WorkItem[]
  workEffects       WorkEffect[]
  developmentOrders DevelopmentOrder[]

  @@map("organizations")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  memberships OrganizationMember[]

  @@map("users")
}

model OrganizationMember {
  id             String   @id @default(cuid())
  organizationId String   @map("organization_id")
  userId         String   @map("user_id")
  role           String
  createdAt      DateTime @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([organizationId, userId])
  @@index([organizationId])
  @@index([userId])
  @@map("organization_members")
}

model Project {
  id             String   @id @default(cuid())
  organizationId String   @map("organization_id")
  name           String
  description    String?
  status         String   @default("active")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  companies      Company[]
  contacts       Contact[]
  tasks          Task[]
  jobs           Job[]
  activities     Activity[]
  meetings       Meeting[]
  memos          Memo[]
  documents      Document[]
  communications Communication[]
  memoryEntries  MemoryEntry[]
  conversations  Conversation[]
  context          ProjectContext?
  cursorSessions   CursorSession[]
  knowledgeSources KnowledgeSource[]
  knowledgeItems   KnowledgeItem[]
  workspaceEntries WorkspaceEntry[]
  artifacts        Artifact[]

  @@index([organizationId])
  @@map("projects")
}

model Company {
  id             String   @id @default(cuid())
  organizationId String   @map("organization_id")
  projectId      String?  @map("project_id")
  name           String
  industry       String?
  website        String?
  notes          String?
  sourceId       String?  @map("source_id")
  isMock         Boolean  @default(false) @map("is_mock")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  project        Project?        @relation(fields: [projectId], references: [id], onDelete: SetNull)
  contacts       Contact[]
  communications Communication[]
  activities     Activity[]
  memoryEntries  MemoryEntry[]
  tasks          Task[]
  conversations  Conversation[]

  @@index([organizationId])
  @@index([organizationId, name])
  @@map("companies")
}

model Contact {
  id             String   @id @default(cuid())
  organizationId String   @map("organization_id")
  companyId      String?  @map("company_id")
  projectId      String?  @map("project_id")
  firstName      String   @map("first_name")
  lastName       String   @map("last_name")
  role           String?
  email          String?
  phone          String?
  notes          String?
  sourceId       String?  @map("source_id")
  isMock         Boolean  @default(false) @map("is_mock")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  company        Company?        @relation(fields: [companyId], references: [id], onDelete: SetNull)
  project        Project?        @relation(fields: [projectId], references: [id], onDelete: SetNull)
  communications Communication[]
  activities     Activity[]
  memoryEntries  MemoryEntry[]
  tasks          Task[]
  conversations  Conversation[]

  @@index([organizationId])
  @@index([companyId])
  @@map("contacts")
}

model Task {
  id             String    @id @default(cuid())
  organizationId String    @map("organization_id")
  projectId      String?   @map("project_id")
  companyId      String?   @map("company_id")
  contactId      String?   @map("contact_id")
  title          String
  description    String?
  status         String    @default("open")
  priority       String    @default("medium")
  dueAt          DateTime? @map("due_at")
  followUpAt     DateTime? @map("follow_up_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  project      Project?     @relation(fields: [projectId], references: [id], onDelete: SetNull)
  company      Company?     @relation(fields: [companyId], references: [id], onDelete: SetNull)
  contact      Contact?     @relation(fields: [contactId], references: [id], onDelete: SetNull)
  activities   Activity[]

  @@index([organizationId])
  @@index([organizationId, status])
  @@map("tasks")
}

model Job {
  id             String    @id @default(cuid())
  organizationId String    @map("organization_id")
  projectId      String?   @map("project_id")
  userRequest    String    @map("user_request")
  goal           String
  status          String    @default("pending")
  resumeState     String?   @map("resume_state")
  scheduledAt     DateTime? @map("scheduled_at")
  pauseReason     String?   @map("pause_reason")
  attemptCount    Int       @default(0) @map("attempt_count")
  idempotencyKey  String?   @map("idempotency_key")
  createdAt       DateTime  @default(now()) @map("created_at")
  startedAt       DateTime? @map("started_at")
  completedAt     DateTime? @map("completed_at")

  organization     Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  project          Project?          @relation(fields: [projectId], references: [id], onDelete: SetNull)
  steps            JobStep[]
  approvalRequests ApprovalRequest[]
  activities       Activity[]
  conversations    Conversation[]
  computerJobs     ComputerJob[]
  computerActions  ComputerAction[]
  cursorSessions   CursorSession[]
  sources          Source[]
  knowledgeImports KnowledgeImport[]
  knowledgeSources KnowledgeSource[]
  artifacts        Artifact[]
  reviewSessions   ReviewSession[]
  workItems        WorkItem[]
  developmentOrders DevelopmentOrder[]

  @@index([organizationId])
  @@index([organizationId, status])
  @@map("jobs")
}

model DevelopmentOrder {
  id                   String   @id @default(cuid())
  organizationId       String   @map("organization_id")
  jobId                String?  @map("job_id")
  userRequest          String   @map("user_request")
  goal                 String
  desiredBehavior      String   @map("desired_behavior")
  existingCapabilities String   @map("existing_capabilities")
  gap                  String
  requirements         String
  constraints          String
  approvalRules        String   @map("approval_rules")
  acceptance           String
  status               String   @default("planned")
  iteration            Int      @default(0)
  maxIterations        Int      @default(2) @map("max_iterations")
  history              String   @default("[]")
  resultSummary        String?  @map("result_summary")
  cursorSessionId      String?  @map("cursor_session_id")
  workspacePath        String?  @map("workspace_path")
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  job          Job?         @relation(fields: [jobId], references: [id], onDelete: SetNull)

  @@index([organizationId, status])
  @@map("development_orders")
}

model JobStep {
  id             String    @id @default(cuid())
  organizationId String    @map("organization_id")
  jobId          String    @map("job_id")
  agent          String
  action         String
  status         String    @default("pending")
  input          String
  output         String?
  startedAt      DateTime? @map("started_at")
  completedAt    DateTime? @map("completed_at")
  error          String?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  job          Job          @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([jobId])
  @@map("job_steps")
}

model Activity {
  id                String   @id @default(cuid())
  organizationId    String   @map("organization_id")
  timestamp         DateTime
  type              String
  title             String
  description       String?
  status            String
  projectId         String?  @map("project_id")
  companyId         String?  @map("company_id")
  contactId         String?  @map("contact_id")
  taskId            String?  @map("task_id")
  communicationId   String?  @map("communication_id")
  jobId             String?  @map("job_id")
  externalReference String?  @map("external_reference")
  externalUrl       String?  @map("external_url")
  metadata          String?
  createdAt         DateTime @default(now()) @map("created_at")

  organization  Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  project       Project?       @relation(fields: [projectId], references: [id], onDelete: SetNull)
  company       Company?       @relation(fields: [companyId], references: [id], onDelete: SetNull)
  contact       Contact?       @relation(fields: [contactId], references: [id], onDelete: SetNull)
  task          Task?          @relation(fields: [taskId], references: [id], onDelete: SetNull)
  communication Communication? @relation(fields: [communicationId], references: [id], onDelete: SetNull)
  job           Job?           @relation(fields: [jobId], references: [id], onDelete: SetNull)

  @@index([organizationId, timestamp])
  @@index([organizationId, type])
  @@map("activities")
}

model MemoryEntry {
  id                    String   @id @default(cuid())
  organizationId        String   @map("organization_id")
  type                  String
  title                 String
  content               String
  projectId             String?  @map("project_id")
  companyId             String?  @map("company_id")
  contactId             String?  @map("contact_id")
  sourceId              String?  @map("source_id")
  sourceType            String   @map("source_type")
  sourceReference       String?  @map("source_reference")
  sourceUrl             String?  @map("source_url")
  conversationMessageId String?  @map("conversation_message_id")
  version               Int      @default(1)
  fulltext              String
  embeddingRef          String?  @map("embedding_ref")
  createdAt             DateTime @default(now()) @map("created_at")
  updatedAt             DateTime @updatedAt @map("updated_at")

  organization        Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  project             Project?              @relation(fields: [projectId], references: [id], onDelete: SetNull)
  company             Company?              @relation(fields: [companyId], references: [id], onDelete: SetNull)
  contact             Contact?              @relation(fields: [contactId], references: [id], onDelete: SetNull)
  source              Source?               @relation(fields: [sourceId], references: [id], onDelete: SetNull)
  conversationMessage ConversationMessage?  @relation(fields: [conversationMessageId], references: [id], onDelete: SetNull)
  fromRelations       MemoryRelation[]      @relation("RelationFrom")
  toRelations         MemoryRelation[]      @relation("RelationTo")
  knowledgeItems      KnowledgeItem[]

  @@index([organizationId])
  @@index([organizationId, type])
  @@index([organizationId, fulltext])
  @@index([conversationMessageId])
  @@map("memory_entries")
}

model MemoryRelation {
  id             String   @id @default(cuid())
  organizationId String   @map("organization_id")
  fromId         String   @map("from_id")
  toId           String   @map("to_id")
  relationType   String   @map("relation_type")
  metadata       String?
  createdAt      DateTime @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  from         MemoryEntry  @relation("RelationFrom", fields: [fromId], references: [id], onDelete: Cascade)
  to           MemoryEntry  @relation("RelationTo", fields: [toId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([fromId])
  @@index([toId])
  @@map("memory_relations")
}

model Meeting {
  id                String    @id @default(cuid())
  organizationId    String    @map("organization_id")
  projectId         String?   @map("project_id")
  title             String
  startsAt          DateTime  @map("starts_at")
  endsAt            DateTime? @map("ends_at")
  location          String?
  notes             String?
  externalReference String?   @map("external_reference")
  externalUrl       String?   @map("external_url")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  project      Project?     @relation(fields: [projectId], references: [id], onDelete: SetNull)
  memos        Memo[]

  @@index([organizationId])
  @@map("meetings")
}

model Memo {
  id             String   @id @default(cuid())
  organizationId String   @map("organization_id")
  meetingId      String?  @map("meeting_id")
  projectId      String?  @map("project_id")
  title          String
  content        String
  decisions      String?
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  meeting      Meeting?     @relation(fields: [meetingId], references: [id], onDelete: SetNull)
  project      Project?     @relation(fields: [projectId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@map("memos")
}

model Document {
  id                String   @id @default(cuid())
  organizationId    String   @map("organization_id")
  projectId         String?  @map("project_id")
  title             String
  path              String?
  mimeType          String?  @map("mime_type")
  content           String?
  externalReference String?  @map("external_reference")
  externalUrl       String?  @map("external_url")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  project      Project?     @relation(fields: [projectId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@map("documents")
}

model Communication {
  id                String    @id @default(cuid())
  organizationId    String    @map("organization_id")
  projectId         String?   @map("project_id")
  companyId         String?   @map("company_id")
  contactId         String?   @map("contact_id")
  channel           String
  direction         String
  subject           String
  body              String
  status            String    @default("draft")
  isMock            Boolean   @default(false) @map("is_mock")
  externalReference String?   @map("external_reference")
  externalUrl       String?   @map("external_url")
  sentAt            DateTime? @map("sent_at")
  deliveryStatus    String    @default("PREPARED") @map("delivery_status")
  mailAccountId     String?   @map("mail_account_id")
  mailThreadId      String?   @map("mail_thread_id")
  inReplyTo         String?   @map("in_reply_to")
  referencesHeader  String?   @map("references_header")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  project      Project?     @relation(fields: [projectId], references: [id], onDelete: SetNull)
  company      Company?     @relation(fields: [companyId], references: [id], onDelete: SetNull)
  contact      Contact?     @relation(fields: [contactId], references: [id], onDelete: SetNull)
  activities   Activity[]

  @@index([organizationId])
  @@index([organizationId, status])
  @@map("communications")
}

model ApprovalRequest {
  id             String    @id @default(cuid())
  organizationId String    @map("organization_id")
  jobId          String?   @map("job_id")
  actionType     String    @map("action_type")
  description    String
  payload        String
  status         String    @default("pending")
  createdAt      DateTime  @default(now()) @map("created_at")
  approvedAt     DateTime? @map("approved_at")

  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  job            Job?            @relation(fields: [jobId], references: [id], onDelete: SetNull)
  reviewSessions ReviewSession[]

  @@index([organizationId])
  @@index([organizationId, status])
  @@map("approval_requests")
}

model ApprovalPolicy {
  id             String    @id @default(cuid())
  organizationId String    @map("organization_id")
  name           String
  actionType     String    @map("action_type")
  scope          String
  conditions     String
  limits         String
  createdAt      DateTime  @default(now()) @map("created_at")
  revokedAt      DateTime? @map("revoked_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@map("approval_policies")
}

model Conversation {
  id             String   @id @default(cuid())
  organizationId String   @map("organization_id")
  title          String?
  origin         String
  externalId     String?  @map("external_id")
  checksum       String?
  importedAt     DateTime? @map("imported_at")
  startedAt      DateTime @default(now()) @map("started_at")
  lastActivityAt DateTime @default(now()) @map("last_activity_at")
  status         String   @default("active")
  projectId      String?  @map("project_id")
  companyId      String?  @map("company_id")
  contactId      String?  @map("contact_id")
  jobId          String?  @map("job_id")
  metadata       String?
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  project      Project?              @relation(fields: [projectId], references: [id], onDelete: SetNull)
  company      Company?              @relation(fields: [companyId], references: [id], onDelete: SetNull)
  contact      Contact?              @relation(fields: [contactId], references: [id], onDelete: SetNull)
  job          Job?                  @relation(fields: [jobId], references: [id], onDelete: SetNull)
  messages     ConversationMessage[]

  @@index([organizationId])
  @@index([organizationId, status])
  @@index([organizationId, lastActivityAt])
  @@index([organizationId, origin, externalId])
  @@map("conversations")
}

model ConversationMessage {
  id                String   @id @default(cuid())
  organizationId    String   @map("organization_id")
  conversationId    String   @map("conversation_id")
  role              String
  content           String
  inputMode         String   @default("text") @map("input_mode")
  status            String   @default("final")
  visible           Boolean  @default(false)
  fulltext          String   @default("")
  metadata          String?
  externalId        String?  @map("external_id")
  parentExternalId  String?  @map("parent_external_id")
  createdAt         DateTime @default(now()) @map("created_at")

  organization  Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  conversation  Conversation  @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  memoryEntries MemoryEntry[]

  @@index([organizationId])
  @@index([conversationId])
  @@index([organizationId, createdAt])
  @@index([organizationId, fulltext])
  @@index([organizationId, externalId])
  @@map("conversation_messages")
}

model Source {
  id             String    @id @default(cuid())
  organizationId String    @map("organization_id")
  jobId          String?   @map("job_id")
  type           String
  reference      String?
  url            String?
  canonicalUrl   String?   @map("canonical_url")
  title          String?
  domain         String?
  publishedAt    DateTime? @map("published_at")
  retrievedAt    DateTime? @map("retrieved_at")
  provider       String?
  excerpt        String?
  trustTier      String?   @map("trust_tier")
  trustScore     Int?      @map("trust_score")
  metadata       String?
  label          String?
  createdAt      DateTime  @default(now()) @map("created_at")

  organization      Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  job               Job?             @relation(fields: [jobId], references: [id], onDelete: SetNull)
  memoryEntries     MemoryEntry[]
  knowledgeSourceId String?          @map("knowledge_source_id")
  knowledgeSource   KnowledgeSource? @relation(fields: [knowledgeSourceId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([organizationId, jobId])
  @@index([organizationId, url])
  @@index([knowledgeSourceId])
  @@map("sources")
}

model ConnectorConfig {
  id             String   @id @default(cuid())
  organizationId String   @map("organization_id")
  type           String
  provider       String
  enabled        Boolean  @default(false)
  config         String
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, type, provider])
  @@index([organizationId])
  @@map("connector_configs")
}

model AiProviderConfig {
  id             String   @id @default(cuid())
  organizationId String   @map("organization_id")
  provider       String
  role           String
  model          String?
  enabled        Boolean  @default(true)
  config         String?
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, role])
  @@index([organizationId])
  @@map("ai_provider_configs")
}

model ComputerJob {
  id              String    @id @default(cuid())
  organizationId  String    @map("organization_id")
  jobId           String?   @map("job_id")
  goal            String
  userRequest     String    @map("user_request")
  status          String
  cancelRequested Boolean   @default(false) @map("cancel_requested")
  plan            String?
  result          String?
  error           String?
  startedAt       DateTime  @default(now()) @map("started_at")
  finishedAt      DateTime? @map("finished_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  job          Job?         @relation(fields: [jobId], references: [id], onDelete: SetNull)

  @@index([organizationId, status])
  @@index([organizationId, startedAt])
  @@map("computer_jobs")
}

model ComputerAction {
  id             String    @id @default(cuid())
  organizationId String    @map("organization_id")
  jobId          String?   @map("job_id")
  stepId         String?   @map("step_id")
  tool           String
  action         String
  target         String?
  riskLevel      String    @map("risk_level")
  approvalId     String?   @map("approval_id")
  status         String
  startedAt      DateTime  @map("started_at")
  finishedAt     DateTime? @map("finished_at")
  verification   String?
  error          String?
  metadata       String?
  createdAt      DateTime  @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  job          Job?         @relation(fields: [jobId], references: [id], onDelete: SetNull)

  @@index([organizationId, startedAt])
  @@index([organizationId, jobId])
  @@map("computer_actions")
}

model ProjectContext {
  id             String    @id @default(cuid())
  organizationId String    @map("organization_id")
  projectId      String    @unique @map("project_id")
  localPath      String?   @map("local_path")
  repository     String?
  branch         String?
  framework      String?
  architecture   String?
  rules          String?
  decisions      String?
  openItems      String?   @map("open_items")
  lastChanges    String?   @map("last_changes")
  lastAnalyzedAt DateTime? @map("last_analyzed_at")
  metadata       String?
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
